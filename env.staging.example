# EC2 스테이징 환경용 환경변수 파일
# 이 파일을 .env.staging로 복사하고 실제 값으로 수정하세요

# Spring Profile
SPRING_PROFILES_ACTIVE=staging

# Database Configuration
SPRING_DATASOURCE_URL=jdbc:postgresql://database-1.crm2ew04sd35.ap-northeast-2.rds.amazonaws.com:5432/fintech?sslmode=require
SPRING_DATASOURCE_USERNAME=fintech
SPRING_DATASOURCE_PASSWORD=fintech10!

# Server Configuration
SERVER_PORT=8090

# JWT Configuration (운영용으로 변경 필요)
JWT_SECRET=your-super-secret-jwt-key-here-change-this-in-production

# Redis Configuration (ElastiCache 사용 시)
REDIS_HOST=your-elasticache-endpoint.amazonaws.com
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password
